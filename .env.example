# SYCO23 Mixsets provider configuration
PORT=8787
CORS_ORIGIN=http://localhost:5173
CATALOG_DB_PATH=./data/catalog.sqlite
CURATOR_PASSWORD_HASH=

# Authentication is on unless explicitly set to off. AUTH_MODE=off grants every
# caller curator rights, including in production; keep the default unless the
# deployment is intentionally operated as an open single-user archive.
AUTH_MODE=on

# Official SoundCloud API OAuth token. Required for live SoundCloud discovery.
SOUNDCLOUD_ACCESS_TOKEN=

# Optional but strongly recommended for higher Discogs rate limits.
DISCOGS_TOKEN=

# Use none with HTTPS when the approved frontend is on vercel.app.
CURATOR_COOKIE_SAME_SITE=lax
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Backward-compatible local-only shortcut. Ignored when NODE_ENV=production;
# deployed open access must use the explicit AUTH_MODE=off setting above.
CURATOR_AUTH_DISABLED=false
